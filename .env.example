# Copy to .env.local only to override defaults. Restart after any changes here.
# No environment variables or provider credentials are required to start ClipFlow.

# Local server and OAuth origin (HTTP loopback only). Use the same address in the browser.
APP_URL=http://localhost:3001
APP_TIMEZONE=Asia/Kolkata

# Keep the SQLite database and managed media outside public/ and outside Git.
DATABASE_URL=file:./data/database/clipflow.db
STORAGE_PATH=./data
MAX_UPLOAD_MIB=512
YOUTUBE_ANALYTICS_CACHE_HOURS=24

# Leave blank to find FFmpeg and FFprobe on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Leave blank for a securely generated per-installation key beside the database.
# An explicit override must be a private, random 64-character hexadecimal key.
TOKEN_ENCRYPTION_KEY=

# Optional provider fallbacks. You can save and test these in Integrations instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
META_LOGIN_CONFIG_ID=
GEMINI_API_KEY=
GEMINI_MODEL=
ASSEMBLYAI_API_KEY=

# Required for Instagram OAuth only. Keep the trusted localhost TLS key outside Git.
META_TLS_CERT=
META_TLS_KEY=
