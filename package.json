{
  "name": "clippublisher",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first publishing workspace for YouTube and Instagram clips.",
  "repository": { "type": "git", "url": "https://github.com/Sarif-02/ClipFlow.git" },
  "engines": { "node": "24.x" },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/migrate.mjs development",
    "dev": "node scripts/local.mjs --dev",
    "build": "next build",
    "prestart": "node scripts/migrate.mjs",
    "start": "node scripts/local.mjs",
    "worker": "node scripts/worker.mjs",
    "db:deploy": "node scripts/migrate.mjs --deploy",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@google/genai": "3.6.0",
    "@next/env": "16.4.6",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.65.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
